<view class="page">
  <view class="topbar">
    <view class="back" bindtap="onBack">‹</view>
    <view class="q-title">{{quizTitle}}</view>
    <view class="progress-text">
      <text class="cur">{{curIndex + 1}}</text>
      <text class="total"> / {{total}}</text>
    </view>
  </view>

  <view class="progress">
    <view class="progress-fill" style="width: {{percent}}%"></view>
  </view>

  <view class="question" wx:if="{{current}}">
    <view class="q-no">第 {{curIndex + 1}} 题</view>
    <view class="q-text">{{current.title}}</view>
    <view class="q-hint">{{nickName}}，{{quizHint}}</view>
  </view>

  <view class="scale">
    <view
      wx:for="{{scale}}"
      wx:for-item="label"
      wx:for-index="idx"
      wx:key="*this"
      class="scale-col {{curAnswer === idx ? 'selected' : ''}}"
      hover-class="scale-col-hover"
      hover-start-time="0"
      hover-stay-time="120"
      data-index="{{idx}}"
      catchtap="onSelect"
    >
      <view class="circle {{curAnswer === idx ? 'active' : ''}}">
        <text wx:if="{{curAnswer !== idx}}" class="num">{{idx + 1}}</text>
        <text wx:else class="check">✓</text>
      </view>
      <view class="scale-label {{curAnswer === idx ? 'active' : ''}}">{{label}}</view>
    </view>
  </view>

  <view class="footer">
    <view class="act outline {{curIndex === 0 ? 'disabled' : ''}}" bindtap="onPrev">上一题</view>
    <view class="act solid {{curAnswer === null ? 'disabled' : ''}}" bindtap="onNext">下一题</view>
  </view>
</view>
