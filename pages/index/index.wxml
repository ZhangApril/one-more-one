<view class="page">
  <!-- 首页横幅插画（生成图，对齐原型 01_首页） -->
  <view class="hero">
    <image class="hero-img" src="{{heroBanner}}" mode="widthFix"></image>
    <text class="hero-tagline">{{heroTagline}}</text>
  </view>

  <!-- 奶油白文案区 -->
  <view class="content">
    <view class="brand">{{brand}}</view>
    <view class="brand-sub">{{brandSubCn}}</view>
    <view class="lead">{{lead}}</view>

    <view class="auth-card">
      <!-- 透明热区只覆盖头像圆，昵称输入框必须保持可原生点击，
           否则会拦截微信键盘上方「使用微信昵称」的点击 -->
      <view class="avatar-wrap">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <image wx:else class="avatar-camera" src="{{cameraIcon}}" mode="aspectFit"></image>
        <button
          class="avatar-pick"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          hover-class="avatar-pick-hover"
        ></button>
      </view>
      <input
        class="nickname-input"
        type="nickname"
        focus="{{nickFocus}}"
        placeholder="点击使用微信昵称"
        placeholder-class="nickname-placeholder"
        value="{{nickName}}"
        bindinput="onNicknameInput"
        bindchange="onNicknameChange"
        bindblur="onNicknameBlur"
      />

      <button class="skip-btn" hover-class="skip-hover" bindtap="onSkip">{{skipText}}</button>
    </view>

    <button class="btn btn-primary start-btn" bindtap="onStart">{{startText}}</button>
    <view class="trust">{{trust}}</view>
  </view>
</view>
