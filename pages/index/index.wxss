.page {
  position: relative;
  min-height: 100vh;
  background: var(--ono-bg);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ========== 首页横幅插画 ========== */
.hero {
  position: relative;
  width: 100%;
  background: #1E3A2A;
  overflow: hidden;
}

.hero-img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-tagline {
  position: absolute;
  left: 48rpx;
  top: 48rpx;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 34rpx;
  letter-spacing: 6rpx;
  color: #F0E6D0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

/* ========== 奶油白文案区 ========== */
.content {
  padding: 48rpx 48rpx 0;
  display: flex;
  flex-direction: column;
}

.brand {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--ono-text);
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ono-forest);
}

.lead {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ono-text-sub);
}

/* 授权卡（新版原型无此卡，按已确认需求补充） */
.auth-card {
  margin-top: 40rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 2rpx solid var(--ono-border);
  border-radius: var(--ono-radius-lg);
  box-shadow: var(--ono-shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 透明热区：只覆盖头像圆，点任意位置都可拉起微信头像选择 */
.avatar-pick {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  font-size: 0;
  line-height: 1;
}

.avatar-pick::after {
  border: none;
}

.avatar-pick-hover {
  background: rgba(30, 58, 42, 0.08);
}

/* 正圆头像 */
.avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F1E6D2;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(30, 58, 42, 0.12);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

/* 未上传头像时的默认相机图 */
.avatar-camera {
  width: 128rpx;
  height: 128rpx;
  padding: 32rpx;
  box-sizing: border-box;
  opacity: 0.75;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--ono-bg);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--ono-text);
  text-align: center;
}

.nickname-placeholder {
  color: #B9AC93;
}

/* 游客入口：用 button 承载，保证点击一定可响应 */
.skip-btn {
  position: relative;
  z-index: 3;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  background: transparent;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--ono-primary);
}

.skip-btn::after {
  border: none;
}

.skip-hover {
  opacity: 0.6;
}

/* 立即测试：呼吸缩放 + 流光扫过，吸引点击 */
.start-btn {
  position: relative;
  overflow: hidden;
  margin-top: 48rpx;
  animation: start-breathe 2.6s ease-in-out infinite;
}

.start-btn::after {
  border: none;
}

.start-label {
  position: relative;
  z-index: 2;
}

/* 斜向流光：从左上扫到右下，循环一次后停 1.2s */
.start-shine {
  position: absolute;
  top: -60%;
  left: -60%;
  z-index: 1;
  width: 45%;
  height: 220%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.45) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(20deg);
  animation: start-shine 3.2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes start-breathe {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 10rpx 24rpx rgba(192, 69, 61, 0.28);
  }
  50% {
    transform: scale(1.028);
    box-shadow: 0 18rpx 36rpx rgba(192, 69, 61, 0.42);
  }
}

@keyframes start-shine {
  0% {
    transform: translateX(0) rotate(20deg);
  }
  55%,
  100% {
    /* 位移按自身宽度计算，确保完整扫过按钮（自身宽约 300rpx） */
    transform: translateX(340%) rotate(20deg);
  }
}

/* 按下时停掉动效（否则 animation 的 transform 会覆盖按压反馈），保证点击手感 */
.start-hover {
  animation: none;
  transform: scale(0.97);
  opacity: 0.9;
}

.trust {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--ono-text-sub);
  text-align: center;
}
