.page {
  position: relative;
  min-height: 100vh;
  background: var(--ono-bg);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.wrap {
  padding: 24rpx 40rpx 0;
}

/* ========== 人格卡片 ========== */
.persona-card {
  position: relative;
  border-radius: var(--ono-radius-lg);
  overflow: hidden;
  box-shadow: var(--ono-shadow);
  padding: 32rpx 32rpx 48rpx;
  color: #FFFFFF;
  animation: cardIn 0.4s ease both;
}

/* 深绿渐变（小红帽型） */
.persona-card.camp-hood {
  background: linear-gradient(160deg, #26432F 0%, #1E3A2A 60%, #183024 100%);
}

/* 深灰绿（大灰狼型） */
.persona-card.camp-wolf {
  background: linear-gradient(160deg, #2A3430 0%, #222B27 60%, #1B231F 100%);
}

/* 隐藏结局：灰红渐变 */
.persona-card.camp-wolfking {
  background: linear-gradient(160deg, #3A2E2C 0%, #52302C 60%, #6E2B26 100%);
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.persona-card.flip {
  animation: flipY 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes flipY {
  0% {
    transform: rotateY(0deg);
  }
  50% {
    transform: rotateY(90deg) scale(0.96);
  }
  100% {
    transform: rotateY(0deg);
  }
}

/* 身份行：授权用户显示微信头像+昵称，游客显示默认小红帽头像+「游客」 */
.pc-user {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

.user-name {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pc-lead {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.badge {
  padding: 8rpx 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: var(--ono-text);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.persona-img {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 8rpx auto 0;
}

.role {
  margin-top: 8rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.subtitle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ono-gold);
}

.slogan {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.92);
}

/* ========== 隐藏结局 ========== */
.wolf-tip {
  margin: 24rpx 0 8rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--ono-radius);
  background: rgba(192, 69, 61, 0.1);
  border: 2rpx solid rgba(192, 69, 61, 0.4);
  font-size: 24rpx;
  color: var(--ono-primary);
  text-align: center;
}

.toggle-wolf {
  margin: 8rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--ono-primary);
  text-align: center;
}

/* ========== 白卡通用 ========== */
.card {
  background: #FFFFFF;
  border-radius: var(--ono-radius-lg);
  box-shadow: var(--ono-shadow);
  padding: 32rpx;
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ono-text);
  margin-bottom: 24rpx;
}

/* 维度解析 */
.dim {
  margin-bottom: 32rpx;
}

.dim:last-child {
  margin-bottom: 0;
}

.dim-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dim-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ono-text);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.dim-values {
  font-size: 24rpx;
  color: var(--ono-text-sub);
  text-align: right;
}

.dim-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #EFE5D2;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--ono-forest);
}

/* 特质 tag：红/绿交替 */
.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.tag-green {
  background: rgba(46, 90, 66, 0.12);
  color: var(--ono-forest);
}

.tag-red {
  background: rgba(192, 69, 61, 0.1);
  color: var(--ono-primary);
}

/* 分析 */
.para {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #3A4A40;
}

.disclaimer {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ono-text-sub);
  text-align: center;
}

.retest {
  margin-top: 20rpx;
}
